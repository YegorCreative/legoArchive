---
import {
  imageUrl,
  printedNumber,
  relatedSets,
  rootTheme,
  type LoadedCatalog,
  type SetRecord,
} from "../lib/catalog";
import { formatCount } from "../lib/format";
import { href } from "../lib/href";
import { adjustPurchasingPower, latestCompleteCpiYear } from "../lib/inflation";
import { verifiedPrice } from "../lib/price-index";
import { appreciationPercent, formatMoney, formatPercent, pricePerPiece, type PriceObservation } from "../lib/pricing";

interface Props {
  catalog: LoadedCatalog;
  set: SetRecord;
}
const { catalog, set } = Astro.props;
const theme = catalog.themeById.get(set.themeId) ?? null;
const root = rootTheme(set.themeId, catalog.themeById);
const related = relatedSets(catalog, set);
const original = verifiedPrice(set.id, "original-retail");
const mailOrder = verifiedPrice(set.id, "mail-order");
const currentShop = verifiedPrice(set.id, "current-shop");
const marketNew = verifiedPrice(set.id, "market-new");
const marketUsed = verifiedPrice(set.id, "market-used");
const marketIncomplete = verifiedPrice(set.id, "market-incomplete");
const auction = verifiedPrice(set.id, "auction-sale");
const change = appreciationPercent(original, marketNew ?? marketUsed ?? auction);
const comparisonYear = latestCompleteCpiYear();
const adjust = (price: PriceObservation | null) => {
  if (!price || price.currency !== "USD") return null;
  const year = Number(price.date.slice(0, 4));
  return adjustPurchasingPower(price.amount, Number.isInteger(year) ? year : null, comparisonYear);
};
const adjustedMsrp = adjust(original);
const adjustedCatalog = adjust(mailOrder);
const marketPoints = [marketNew, marketUsed, marketIncomplete, auction].filter((price) => price != null).length;
const laterDollars = (amount: number | null) =>
  amount != null && comparisonYear != null ? `${formatMoney(amount, "USD")} in ${comparisonYear} dollars` : "Not calculated";

const groups = [
  { title: "Other catalog records with the same printed number", note: "These share a printed number in the source file. They are not automatically earlier or later models.", sets: related.variants, more: related.variantMore },
  { title: root ? `More ${root.name} sets from ${set.year}` : `More sets from ${set.year}`, note: null, sets: related.sameYear, more: 0 },
  { title: root ? `More from ${root.name}` : "More from this theme", note: null, sets: related.sameTheme, more: 0 },
  { title: theme && theme.id !== root?.id ? `More in ${theme.name}` : "Same subtheme", note: null, sets: related.sameSubtheme, more: 0 },
].filter((group) => group.sets.length > 0);
---
<article class="set-page">
  <header class="set-hero">
    <figure class="shot">
      <button type="button" class="shot-zoom" data-zoom={imageUrl(catalog.snapshot, set.id)} data-zoom-alt={`${set.name}, set ${set.id}. Catalog photograph, not a 3D model.`}>
        <img class="set-img" src={imageUrl(catalog.snapshot, set.id)} alt={`${set.name}, set ${set.id}`} width="800" height="800" decoding="async" fetchpriority="high" />
        <span class="shot-hint">View photograph</span>
      </button>
    </figure>
    <div>
      <p class="eyebrow">{root?.name ?? "Theme unavailable"}{theme && theme.id !== root?.id ? ` · ${theme.name}` : ""}</p>
      <h1>{set.name}</h1>
      <p class="deck">Set {set.id} · {set.year}</p>
      <p class="quiet">A historical essay for this individual set has not been written. Verified fields from the {catalog.snapshot.sourceName} snapshot are below. Missing fields stay unavailable. The photograph is the single catalog image. It is not a 3D model or another camera angle.</p>
    </div>
  </header>

  <section>
    <h2>General information</h2>
    <dl class="facts">
      <div><dt>Set name</dt><dd>{set.name}</dd></div>
      <div><dt>Catalog number</dt><dd>{set.id}</dd></div>
      <div><dt>Printed number</dt><dd>{printedNumber(set.id)}</dd></div>
      <div><dt>Theme</dt><dd>{root ? <a href={href(`themes/${root.slug}/`)}>{root.name}</a> : "Unavailable"}</dd></div>
      <div><dt>Subtheme</dt><dd>{theme && theme.id !== root?.id ? theme.name : "Same as theme, or not separately recorded"}</dd></div>
      <div><dt>Release year</dt><dd><a href={href(`years/${set.year}/`)}>{set.year}</a></dd></div>
      <div><dt>Exact release date</dt><dd>Unavailable</dd></div>
      <div><dt>Retirement year</dt><dd>Unavailable</dd></div>
      <div><dt>Piece count</dt><dd>{set.parts == null ? "Unavailable" : formatCount(set.parts)}</dd></div>
      <div><dt>Minifigure count</dt><dd>Unavailable</dd></div>
      <div><dt>Recommended age</dt><dd>Unavailable</dd></div>
      <div><dt>Source</dt><dd><a href={catalog.snapshot.sourceUrl}>Rebrickable downloads</a></dd></div>
    </dl>
  </section>

  <section>
    <h2>Price information</h2>
    <dl class="facts">
      <div><dt>Original retail price</dt><dd>{original ? formatMoney(original.amount, original.currency) : "Unavailable"}</dd></div>
      <div><dt>Shop at Home catalog price</dt><dd>{mailOrder ? formatMoney(mailOrder.amount, mailOrder.currency) : "Unavailable"}</dd></div>
      <div><dt>Current LEGO shop price</dt><dd>{currentShop ? formatMoney(currentShop.amount, currentShop.currency) : "Unavailable"}</dd></div>
      <div><dt>Current sealed value</dt><dd>{marketNew ? formatMoney(marketNew.amount, marketNew.currency) : "Unavailable"}</dd></div>
      <div><dt>Current used value</dt><dd>{marketUsed ? formatMoney(marketUsed.amount, marketUsed.currency) : "Unavailable"}</dd></div>
      <div><dt>Used, incomplete</dt><dd>{marketIncomplete ? formatMoney(marketIncomplete.amount, marketIncomplete.currency) : "Unavailable"}</dd></div>
      <div><dt>Verified auction sale</dt><dd>{auction ? formatMoney(auction.amount, auction.currency) : "Unavailable"}</dd></div>
      <div><dt>Inflation-adjusted original price</dt><dd>{laterDollars(original ? adjustedMsrp : null)}</dd></div>
      <div><dt>Catalog price in later dollars</dt><dd>{laterDollars(mailOrder ? adjustedCatalog : null)}</dd></div>
      <div><dt>Value change</dt><dd>{formatPercent(change)}</dd></div>
      <div><dt>Catalog price per piece</dt><dd>{mailOrder ? formatMoney(pricePerPiece(mailOrder.amount, set.parts), mailOrder.currency) : "Unavailable"}</dd></div>
    </dl>
    <p class="quiet">Shop at Home prices include the shipping stated by that catalog and are not store MSRP. Inflation is purchasing power, not collectible appreciation. {marketPoints >= 2 ? "Comparable dated market observations are available." : "A market-value chart is withheld."}</p>
    {mailOrder && (
      <details class="panel source-fold">
        <summary>Catalog price source</summary>
        <dl class="facts">
          <div><dt>Amount</dt><dd>{formatMoney(mailOrder.amount, mailOrder.currency)}</dd></div>
          <div><dt>Currency</dt><dd>{mailOrder.currency}</dd></div>
          <div><dt>Market</dt><dd>{mailOrder.market}</dd></div>
          <div><dt>Condition</dt><dd>Not a used or sealed grade</dd></div>
          <div><dt>Observation date</dt><dd>{mailOrder.date}</dd></div>
          <div><dt>Verified</dt><dd>{mailOrder.verifiedAt}</dd></div>
          <div><dt>Source</dt><dd><a href={mailOrder.sourceUrl}>{mailOrder.source}</a></dd></div>
        </dl>
        {mailOrder.note && <p>{mailOrder.note}</p>}
      </details>
    )}
  </section>

  <section>
    <h2>Related sets</h2>
    {groups.length === 0 ? <p>None in this snapshot.</p> : groups.map((group) => (
      <div class="panel" style="margin-bottom: 0.8rem;">
        <h3>{group.title}</h3>
        {group.note && <p class="quiet">{group.note}</p>}
        {group.sets.length === 0 ? <p>None in this snapshot.</p> : (
          <ul>
            {group.sets.map((item) => <li><a href={href(`sets/${item.id}/`)}>{item.name}</a> · {item.id} · {item.year}</li>)}
          </ul>
        )}
        {group.more > 0 && <p class="quiet">{group.more} more records share this printed number. Search that number to list them.</p>}
      </div>
    ))}
  </section>
</article>
