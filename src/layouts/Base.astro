---
import "../styles/global.css";
import "../styles/build.css";
import { href } from "../lib/href";

interface Props {
  title: string;
  description: string;
  section?: "archive" | "legends";
}
const { title, description, section = "archive" } = Astro.props;
const fullTitle = title === "LEGO Archive" ? title : `${title} · LEGO Archive`;
const path = Astro.url.pathname;
const current = (target: string) => path === href(target);
const canonical = new URL(path, Astro.site);
const primary = [
  { to: "years/", label: "Years" },
  { to: "themes/", label: "Themes" },
  { to: "search/", label: "Search" },
  { to: "price-archive/", label: "Price archive" },
  { to: "timeline/", label: "Timeline" },
  { to: "stories/", label: "Stories" },
  { to: "brick-legends/", label: "Brick Legends" },
  { to: "about/", label: "About" },
];
const here = (to: string) => (to === "brick-legends/" ? path.includes("/brick-legends/") : current(to));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body data-section={section}>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={href("")}>
        <strong>LEGO ARCHIVE</strong>
        <span>Every set. Every year. Every story.</span>
      </a>
      <nav class="site-nav primary-bar" aria-label="Primary">
        {primary.map((item) => (
          <a href={href(item.to)} aria-current={here(item.to) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <details class="nav-pop">
        <summary>Menu</summary>
        <nav class="site-nav" aria-label="Primary">
          {primary.map((item) => (
            <a href={href(item.to)} aria-current={here(item.to) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </details>
    </header>
    {section === "legends" && (
      <nav class="shell site-nav legend-nav" aria-label="Brick Legends">
        <a href={href("brick-legends/")}>Overview</a>
        <a href={href("brick-legends/create/")}>Create</a>
        <a href={href("brick-legends/gallery/")}>Gallery</a>
        <a href={href("brick-legends/collection/")}>Collection</a>
        <a href={href("brick-legends/creators/")}>Creators</a>
        <a href={href("brick-legends/rankings/")}>Rankings</a>
        <a href={href("brick-legends/annual-five/")}>Annual Five</a>
        <a href={href("brick-legends/account/")}>Account</a>
        <a href={href("brick-legends/policies/")}>Policies</a>
      </nav>
    )}
    <main id="content" class="shell page">
      <slot />
    </main>
    <footer class="site-footer">
      <strong>LEGO Archive is an unofficial fan-made encyclopedia.</strong>
      <p>LEGO® is a trademark of the LEGO Group of companies, which does not sponsor, authorize, or endorse this website.</p>
      <p>Catalog data and set images are from Rebrickable, used with attribution. Prices are shown only when a verified observation is stored. This release stores a Fall 1999 US Shop at Home sample. Store MSRP and current market values are not in that sample.</p>
      <nav aria-label="Footer">
        <a href={href("about/")}>About and sources</a>
        <a href={href("brick-legends/policies/")}>Brick Legends policies</a>
        <a href={href("brick-legends/privacy/")}>Privacy draft</a>
        <a href={href("brick-legends/guidelines/")}>Community guidelines</a>
        <a href="https://github.com/YegorCreative/legoArchive">GitHub</a>
      </nav>
    </footer>
    <script src={href("museum.js")} defer></script>
  </body>
</html>
